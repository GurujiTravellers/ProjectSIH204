{
  "name": "smart-tourism",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "proxy": "http://localhost:5000",
  "scripts": {
    "dev": "node scripts/devRunner.js",
    "dev:vite": "vite",
    "dev:server": "node backend/server.js",
    "build": "vite build",
    "postinstall": "npm --prefix backend install",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "build:all": "npm run build && npm --prefix backend install",
    "server:node": "node backend/server.js",
    "server:python": "node -e \"const { spawn } = require('child_process'); spawn(process.platform === 'win32' ? 'python-intelligence\\\\.venv\\\\Scripts\\\\python.exe' : 'python3', ['python-intelligence/app.py'], { stdio: 'inherit' });\"",
    "python:test": "node -e \"const { spawn } = require('child_process'); spawn(process.platform === 'win32' ? 'python-intelligence\\\\.venv\\\\Scripts\\\\python.exe' : 'python3', ['python-intelligence/test_service.py'], { stdio: 'inherit' });\"",
    "server": "node backend/server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0"
  }
}
