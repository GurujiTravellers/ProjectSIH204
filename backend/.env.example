# Travel_Guruji Environment Variables Example
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@travelguruji.mongodb.net/?appName=TravelGuruji
JWT_SECRET=your_jwt_secret_key_here

# ===================================================
# REAL-TIME WEATHER & DISASTER API INTEGRATION
# ===================================================
# Tomorrow.io API Key (Primary Provider for Weather, Severe Weather & Maps)
TOMORROW_IO_API_KEY=
TOMORROW_API_KEY=

# Open-Meteo API Endpoint (Live Real-Time Weather & Fallback Provider - No Key Required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# GDACS RSS XML Feed (Global Disaster Alert and Coordination System - UN & EC)
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml

# USGS Real-Time Earthquake Hazards API (Near-Real-Time Seismic Monitoring)
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# NASA EONET (Earth Observatory Natural Event Tracker API v3)
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3/events

# RainViewer Real-Time Radar API
RAINVIEWER_RADAR_URL=https://api.rainviewer.com/public/weather-maps.json

# Python Intelligence Microservice (Internal Service URL)
PYTHON_INTELLIGENCE_URL=http://127.0.0.1:8000

